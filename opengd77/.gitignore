# Build output. The makefiles in the build folders stay, so the firmware can be
# built from the command line; everything they produce stays out.
*.o
*.d
*.su
*.cyclo
*.elf
*.map
*.list
MDUV380_firmware/MDUV380_*FW/*.bin

# Made by ./prepare (an empty, 0xFF filled codec section). The real AMBE codec
# is never part of this source: the firmware loader adds it from the official
# firmware when the radio is flashed.
MDUV380_firmware/application/source/linkerdata/codec_bin_section_1.bin

# Editor and OS clutter
.vscode/
*.swp
Thumbs.db
.DS_Store

# The 5W build folder is out of date (it does not list the new source files) and
# untested here; only MDUV380_10W_PLUS_FW is maintained. IDE workspace prefs too.
MDUV380_firmware/MDUV380_FW/
MDUV380_firmware/.settings/
